@using System.Security.Claims
@using SocialExposure.Models

@model IEnumerable<Design>

@{
    ViewData["Title"] = "All Designs";

    var designs = Model?.ToList() ?? new List<Design>();

    var currentSearch = ViewBag.Search as string ?? "";

    var currentStatus = ViewBag.Status as string ?? "All";

    var statuses = ViewBag.Statuses as List<string>
                   ?? new List<string>
                   {
                       "Pending Review",
                       "Approved",
                       "Changes Requested",
                       "Rejected"
                   };

    var canUpload =
        User.IsInRole("Staff") ||
        User.IsInRole("Admin");
}

<div class="feature-page">

    <!-- =========================================
         PAGE HEADER
         ========================================= -->

    <div class="feature-header">

        <div>
            <h2>All Designs</h2>

            <p>
                View and manage available design files.
            </p>
        </div>

        @if (canUpload)
        {
            <div class="feature-actions">

                <a class="action-button peach"
                   asp-controller="Design"
                   asp-action="Upload">
                    ↑ Upload Design
                </a>

            </div>
        }

    </div>


    <!-- =========================================
         SEARCH AND FILTER
         ========================================= -->

    <section class="feature-section">

        <form method="get"
              asp-controller="Design"
              asp-action="All"
              class="search-row">

            <label class="search-field">

                <span>⌕</span>

                <input type="search"
                       name="search"
                       value="@currentSearch"
                       placeholder="Search designs..."
                       aria-label="Search designs" />

            </label>


            <select name="status"
                    class="action-button secondary">

                @if (currentStatus == "All")
                {
                    <option value="All" selected>
                        All Status
                    </option>
                }
                else
                {
                    <option value="All">
                        All Status
                    </option>
                }


                @foreach (var item in statuses)
                {
                    @if (currentStatus == item)
                    {
                        <option value="@item" selected>
                            @item
                        </option>
                    }
                    else
                    {
                        <option value="@item">
                            @item
                        </option>
                    }
                }

            </select>


            <button class="action-button secondary"
                    type="submit">
                Search
            </button>


            <a class="action-button secondary"
               asp-controller="Design"
               asp-action="Index">
                Back
            </a>

        </form>


        <!-- =========================================
             DESIGN DATA
             ========================================= -->

        <div class="data-card">

            <div class="data-card-header">

                <h3>
                    Design Files
                </h3>

            </div>


            @if (designs.Any())
            {
                <div class="design-list">

                    @foreach (var design in designs)
                    {
                        <div class="design-list-item">

                            <!-- DESIGN INFORMATION -->

                            <div class="design-info">

                                <h3>
                                    @design.FileName
                                </h3>


                                @if (design.Event != null)
                                {
                                    <p>
                                        Event:
                                        @design.Event.EventName
                                    </p>
                                }


                                @if (design.Client != null)
                                {
                                    <p>
                                        Client:
                                        @design.Client.FullName
                                    </p>
                                }


                                @if (!string.IsNullOrWhiteSpace(
                                    design.Description))
                                {
                                    <p>
                                        @design.Description
                                    </p>
                                }

                            </div>


                            <!-- DESIGN DETAILS -->

                            <div class="design-meta">

                                <span class="design-version">
                                    @design.Version
                                </span>


                                <span class="design-status">
                                    @design.Status
                                </span>


                                <span class="design-date">
                                    @design.UploadedAt.ToString("dd MMM yyyy")
                                </span>


                                @if (!string.IsNullOrWhiteSpace(
                                    design.FilePath))
                                {
                                    <a class="action-button secondary"
                                       href="@design.FilePath"
                                       target="_blank">
                                        View File
                                    </a>
                                }

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="empty-state">

                    <i>▤</i>

                    <h3>
                        No designs found
                    </h3>

                    @if (!string.IsNullOrWhiteSpace(currentSearch))
                    {
                        <p>
                            No designs match your search.
                        </p>
                    }
                    else if (currentStatus != "All")
                    {
                        <p>
                            No designs match the selected filter.
                        </p>
                    }
                    else
                    {
                        <p>
                            Uploaded designs will appear here.
                        </p>
                    }

                </div>
            }

        </div>

    </section>

</div>