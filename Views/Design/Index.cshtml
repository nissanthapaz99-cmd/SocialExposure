@using System.Security.Claims
@{
    ViewData["Title"] = "Designs";
    var role = User.FindFirstValue(ClaimTypes.Role) ?? UserRoles.Client;
    var canUpload = role is UserRoles.Admin or UserRoles.Staff;
}

<div class="feature-page">
    <div class="feature-header">
        <div><h2>Designs</h2><p>Review, organise and approve design files.</p></div>
        @if (canUpload)
        {
            <div class="feature-actions"><a class="action-button peach" asp-controller="Events" asp-action="Index">↑ Upload Design</a></div>
        }
    </div>

    <div class="summary-grid">
        <article class="summary-tile"><i class="summary-tile-icon">▤</i><strong>0</strong><span>Total Designs</span></article>
        <article class="summary-tile"><i class="summary-tile-icon">◷</i><strong>0</strong><span>Pending</span></article>
        <article class="summary-tile"><i class="summary-tile-icon">✓</i><strong>0</strong><span>Approved</span></article>
        <article class="summary-tile"><i class="summary-tile-icon">!</i><strong>0</strong><span>Feedback</span></article>
    </div>

    <section class="feature-section">
        <div class="search-row">
            <label class="search-field"><span>⌕</span><input type="search" placeholder="Search designs..." aria-label="Search designs" /></label>
            <button class="action-button secondary" type="button">Filter</button>
            <button class="action-button secondary" type="button">View All</button>
        </div>
        <div class="data-card">
            <div class="data-card-header"><h3>Recent Design Activity</h3></div>
            <div class="empty-state"><i>▤</i><h3>No designs yet</h3><p>Uploaded designs and client feedback will appear here.</p></div>
        </div>
    </section>
</div>
