@using System.Security.Claims
@using SocialExposure.Models

@model IEnumerable<Design>

@{
    ViewData["Title"] = "Designs";

    var role = User.FindFirstValue(ClaimTypes.Role)
               ?? UserRoles.Client;

    var designs = Model?.ToList()
                   ?? new List<Design>();

    var currentSearch =
        ViewBag.Search as string ?? string.Empty;

    var currentStatus =
        ViewBag.Status as string ?? "All";

    var statuses =
        ViewBag.Statuses as List<string>
        ?? new List<string>
        {
            "Pending Review",
            "Approved",
            "Changes Requested",
            "Rejected"
        };

    var isClient = role == UserRoles.Client;

    var isStaffOrAdmin =
        role == UserRoles.Staff ||
        role == UserRoles.Admin;
}


@if (isClient)
{
    <!-- =====================================================
         CLIENT DESIGN PAGE
         ===================================================== -->

    <div class="client-design-page">

        <!-- HEADER -->

        <div class="client-design-header">

            <div class="client-design-heading">

                <h1>My Designs</h1>

                <p>
                    Review designs shared with you by the design team.
                </p>

            </div>

            <a class="client-upload-button"
               asp-controller="Design"
               asp-action="ClientUpload">

                <span class="upload-icon">↑</span>

                Upload Reference File

            </a>

        </div>


        <!-- SEARCH / FILTER -->

        <div class="client-design-toolbar">

            <form method="get"
                  asp-controller="Design"
                  asp-action="Index"
                  class="client-search-form">

                <div class="client-search-box">

                    <span class="search-icon">⌕</span>

                    <input type="search"
                           name="search"
                           value="@currentSearch"
                           placeholder="Search your designs..."
                           aria-label="Search your designs" />

                </div>


                <select name="status"
                        class="client-status-select">

                    <option value="All"
                            selected="@(currentStatus == "All")">

                        All Status

                    </option>

                    @foreach (var item in statuses)
                    {
                        <option value="@item"
                                selected="@(currentStatus == item)">

                            @item

                        </option>
                    }

                </select>


                <button type="submit"
                        class="client-search-button">

                    Search

                </button>

            </form>

        </div>


        <!-- DESIGN SECTION -->

        <section class="client-design-section">

            <div class="client-section-heading">

                <div>

                    <h2>My Project Designs</h2>

                    <p>
                        Designs assigned to your account will appear here.
                    </p>

                </div>

            </div>


            @if (designs.Any())
            {
                <div class="client-design-list">

                    @foreach (var design in designs)
                    {
                        <article class="client-design-card">

                            <!-- FILE ICON -->

                            <div class="client-design-icon">

                                <span>▤</span>

                            </div>


                            <!-- DESIGN INFORMATION -->

                            <div class="client-design-main">

                                <div class="client-design-title-row">

                                    <div class="client-design-title">

                                        <h3>
                                            @design.FileName
                                        </h3>

                                        @if (design.Event != null)
                                        {
                                            <p class="client-project-name">
                                                @design.Event.EventName
                                            </p>
                                        }

                                    </div>


                                    <span class="client-version">
                                        @design.Version
                                    </span>

                                </div>


                                @if (!string.IsNullOrWhiteSpace(design.Description))
                                {
                                    <p class="client-design-description">
                                        @design.Description
                                    </p>
                                }


                                <div class="client-design-details">

                                    <span>
                                        Uploaded
                                        @design.UploadedAt.ToString("dd MMM yyyy")
                                    </span>


                                    <span class="client-status
                                        @(design.Status == "Approved"
                                            ? "status-approved"
                                            : design.Status == "Rejected"
                                                ? "status-rejected"
                                                : "status-pending")">

                                        @design.Status

                                    </span>

                                </div>

                            </div>


                            <!-- CLIENT ACTIONS -->

                            <div class="client-design-actions">

                                @if (!string.IsNullOrWhiteSpace(design.FilePath))
                                {
                                    <a class="client-preview-button"
                                       href="@design.FilePath"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       title="Preview design">

                                        Preview

                                    </a>
                                }


                                @if (design.Status != "Approved")
                                {
                                    <form asp-controller="Design"
                                          asp-action="Approve"
                                          asp-route-id="@design.Id"
                                          method="post"
                                          class="client-action-form">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="client-approve-button"
                                                title="Approve design">

                                            ✓ Approve

                                        </button>

                                    </form>
                                }


                                @if (design.Status != "Rejected")
                                {
                                    <form asp-controller="Design"
                                          asp-action="NotApproved"
                                          asp-route-id="@design.Id"
                                          method="post"
                                          class="client-action-form">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="client-reject-button"
                                                title="Mark design as not approved">

                                            ✕ Not Approved

                                        </button>

                                    </form>
                                }

                            </div>

                        </article>
                    }

                </div>
            }
            else
            {
                <!-- EMPTY STATE -->

                <div class="client-empty-state">

                    <div class="client-empty-icon">
                        ▤
                    </div>

                    <h3>
                        No designs available yet
                    </h3>

                    <p>
                        Your design files will appear here once
                        the design team uploads them.
                    </p>

                    <a class="client-empty-upload-button"
                       asp-controller="Design"
                       asp-action="ClientUpload">

                        Upload Reference File

                    </a>

                </div>
            }

        </section>

    </div>
}
else if (isStaffOrAdmin)
{
    <!-- =====================================================
         STAFF / ADMIN DESIGN PAGE
         ===================================================== -->

    <div class="staff-design-page">

        <!-- PAGE HEADER -->

        <div class="staff-design-header">

            <div class="staff-design-heading">

                <span class="staff-page-label">
                    DESIGN MANAGEMENT
                </span>

                <h1>Designs</h1>

                <p>
                    Manage design files, review client responses,
                    and track the latest design versions.
                </p>

            </div>


            <a class="staff-upload-button"
               asp-controller="Design"
               asp-action="Upload">

                <span class="staff-upload-icon">↑</span>

                Upload Design

            </a>

        </div>


        <!-- SEARCH / FILTER -->

        <div class="staff-design-toolbar">

            <form method="get"
                  asp-controller="Design"
                  asp-action="Index"
                  class="staff-search-form">

                <div class="staff-search-box">

                    <span class="staff-search-icon">⌕</span>

                    <input type="search"
                           name="search"
                           value="@currentSearch"
                           placeholder="Search designs, projects or clients..."
                           aria-label="Search designs" />

                </div>


                <select name="status"
                        class="staff-status-select">

                    <option value="All"
                            selected="@(currentStatus == "All")">

                        All Status

                    </option>

                    @foreach (var item in statuses)
                    {
                        <option value="@item"
                                selected="@(currentStatus == item)">

                            @item

                        </option>
                    }

                </select>


                <button type="submit"
                        class="staff-search-button">

                    Search

                </button>


                <a class="staff-view-all-button"
                   asp-controller="Design"
                   asp-action="All">

                    View All

                </a>

            </form>

        </div>


        <!-- DESIGN SECTION -->

        <section class="staff-design-section">

            <div class="staff-section-header">

                <div>

                    <h2>Recent Design Activity</h2>

                    <p>
                        Recently uploaded designs and their current review status.
                    </p>

                </div>

            </div>


            @if (designs.Any())
            {
                <div class="staff-design-list">

                    @foreach (var design in designs)
                    {
                        <article class="staff-design-card">

                            <!-- FILE ICON -->

                            <div class="staff-design-file-icon">

                                <span>▤</span>

                            </div>


                            <!-- MAIN INFORMATION -->

                            <div class="staff-design-content">

                                <div class="staff-design-title-row">

                                    <div class="staff-design-title">

                                        <h3>
                                            @design.FileName
                                        </h3>

                                        @if (design.Event != null)
                                        {
                                            <span class="staff-event-name">
                                                @design.Event.EventName
                                            </span>
                                        }

                                    </div>


                                    <span class="staff-version">
                                        @design.Version
                                    </span>

                                </div>


                                @if (!string.IsNullOrWhiteSpace(design.Description))
                                {
                                    <p class="staff-design-description">
                                        @design.Description
                                    </p>
                                }


                                <div class="staff-design-meta">

                                    <span class="staff-meta-item">

                                        <span class="meta-icon">
                                            ◷
                                        </span>

                                        Uploaded
                                        @design.UploadedAt.ToString("dd MMM yyyy")

                                    </span>


                                    @if (design.Client != null)
                                    {
                                        <span class="staff-meta-item">

                                            <span class="meta-icon">
                                                ●
                                            </span>

                                            @design.Client.FullName

                                        </span>
                                    }


                                    <span class="staff-status
                                        @(design.Status == "Approved"
                                            ? "staff-status-approved"
                                            : design.Status == "Rejected"
                                                ? "staff-status-rejected"
                                                : design.Status == "Changes Requested"
                                                    ? "staff-status-changes"
                                                    : "staff-status-pending")">

                                        <span class="status-dot"></span>

                                        @design.Status

                                    </span>

                                </div>

                            </div>


                            <!-- VIEW FILE -->

                            <div class="staff-design-action">

                                @if (!string.IsNullOrWhiteSpace(design.FilePath))
                                {
                                    <a class="staff-view-button"
                                       href="@design.FilePath"
                                       target="_blank"
                                       rel="noopener noreferrer">

                                        <span>◉</span>

                                        View File

                                    </a>
                                }

                            </div>

                        </article>
                    }

                </div>
            }
            else
            {
                <!-- EMPTY STATE -->

                <div class="staff-empty-state">

                    <div class="staff-empty-icon">
                        ▤
                    </div>

                    <h3>
                        No designs yet
                    </h3>

                    <p>
                        Design files will appear here after
                        a staff member uploads them.
                    </p>

                    <a class="staff-empty-button"
                       asp-controller="Design"
                       asp-action="Upload">

                        Upload First Design

                    </a>

                </div>
            }

        </section>

    </div>
}


<style>

    /* =====================================================
       CLIENT DESIGN PAGE
       ===================================================== */

    .client-design-page {
        width: 100%;
        padding: 10px 0 40px;
    }


    /* =====================================================
       CLIENT HEADER
       ===================================================== */

    .client-design-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
    }


    .client-design-heading h1 {
        margin: 0 0 8px;
        font-size: 42px;
        font-weight: 700;
        line-height: 1.15;
        color: #1F2937;
    }


    .client-design-heading p {
        margin: 0;
        font-size: 16px;
        color: #6B7280;
    }


    /* =====================================================
       CLIENT UPLOAD BUTTON
       ===================================================== */

    .client-upload-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 12px;
        background: #D88B2A;
        color: #FFFFFF;
        text-decoration: none;
        font-size: 15px;
        font-weight: 600;
        white-space: nowrap;
        transition: all 0.2s ease;
    }


    .client-upload-button:hover {
        color: #FFFFFF;
        text-decoration: none;
        opacity: 0.9;
        transform: translateY(-1px);
    }


    .upload-icon {
        font-size: 20px;
        line-height: 1;
    }


    /* =====================================================
       CLIENT SEARCH TOOLBAR
       ===================================================== */

    .client-design-toolbar {
        width: 100%;
        padding: 20px;
        margin-bottom: 28px;
        background: #FFFFFF;
        border: 1px solid #E5E7EB;
        border-radius: 18px;
    }


    .client-search-form {
        display: flex;
        align-items: center;
        gap: 14px;
        width: 100%;
    }


    .client-search-box {
        flex: 1;
        height: 48px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 15px;
        background: #FFFFFF;
        border: 1px solid #D1D5DB;
        border-radius: 12px;
    }


    .client-search-box:focus-within {
        border-color: #971B1B;
        box-shadow: 0 0 0 3px rgba(151, 27, 27, 0.08);
    }


    .search-icon {
        font-size: 22px;
        color: #6B7280;
    }


    .client-search-box input {
        width: 100%;
        height: 100%;
        padding: 0;
        border: none;
        outline: none;
        background: transparent;
        color: #1F2937;
        font-size: 15px;
    }


    .client-status-select {
        height: 48px;
        min-width: 180px;
        padding: 0 14px;
        border: 1px solid #D1D5DB;
        border-radius: 12px;
        background: #FFFFFF;
        color: #1F2937;
        font-size: 15px;
        outline: none;
    }


    .client-search-button {
        height: 48px;
        padding: 0 22px;
        border: none;
        border-radius: 12px;
        background: #971B1B;
        color: #FFFFFF;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
    }


    .client-search-button:hover {
        opacity: 0.92;
    }


    /* =====================================================
       CLIENT SECTION
       ===================================================== */

    .client-design-section {
        width: 100%;
    }


    .client-section-heading {
        margin-bottom: 18px;
    }


    .client-section-heading h2 {
        margin: 0 0 6px;
        font-size: 28px;
        font-weight: 700;
        color: #1F2937;
    }


    .client-section-heading p {
        margin: 0;
        color: #6B7280;
        font-size: 15px;
    }


    /* =====================================================
       CLIENT DESIGN LIST
       ===================================================== */

    .client-design-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }


    /* =====================================================
       CLIENT DESIGN CARD
       ===================================================== */

    .client-design-card {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 22px;
        background: #FFFFFF;
        border: 1px solid #E5E7EB;
        border-radius: 18px;
        transition: all 0.2s ease;
    }


    .client-design-card:hover {
        border-color: #D1D5DB;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
    }


    .client-design-icon {
        width: 52px;
        height: 52px;
        flex: 0 0 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #F8F5F2;
        color: #971B1B;
        font-size: 23px;
    }


    .client-design-main {
        flex: 1;
        min-width: 0;
    }


    .client-design-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }


    .client-design-title h3 {
        margin: 0;
        font-size: 18px;
        font-weight: 650;
        color: #1F2937;
        word-break: break-word;
    }


    .client-project-name {
        margin: 5px 0 0;
        color: #6B7280;
        font-size: 14px;
    }


    .client-version {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 54px;
        height: 30px;
        padding: 0 10px;
        border-radius: 8px;
        background: #F3F4F6;
        color: #374151;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }


    .client-design-description {
        margin: 12px 0 10px;
        color: #6B7280;
        font-size: 14px;
        line-height: 1.5;
    }


    .client-design-details {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        color: #6B7280;
        font-size: 13px;
    }


    .client-status {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 8px;
        background: #F8F5F2;
        color: #6B7280;
        font-weight: 600;
    }


    .status-approved {
        background: #E8F5E9;
        color: #2E7D32;
    }


    .status-rejected {
        background: #FDECEC;
        color: #B42318;
    }


    .status-pending {
        background: #F8F5F2;
        color: #6B7280;
    }


    /* =====================================================
       CLIENT ACTIONS
       ===================================================== */

    .client-design-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 8px;
        max-width: 420px;
    }


    .client-action-form {
        display: inline-flex;
        margin: 0;
    }


    .client-preview-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 18px;
        border: 1px solid #D1D5DB;
        border-radius: 10px;
        background: #FFFFFF;
        color: #1F2937;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        transition: all 0.2s ease;
    }


    .client-preview-button:hover {
        color: #971B1B;
        border-color: #971B1B;
        text-decoration: none;
    }


    .client-approve-button {
        min-height: 42px;
        padding: 0 15px;
        border: 1px solid #2E7D32;
        border-radius: 10px;
        background: #FFFFFF;
        color: #2E7D32;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }


    .client-approve-button:hover {
        background: #2E7D32;
        color: #FFFFFF;
    }


    .client-reject-button {
        min-height: 42px;
        padding: 0 15px;
        border: 1px solid #B42318;
        border-radius: 10px;
        background: #FFFFFF;
        color: #B42318;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }


    .client-reject-button:hover {
        background: #B42318;
        color: #FFFFFF;
    }


    /* =====================================================
       CLIENT EMPTY STATE
       ===================================================== */

    .client-empty-state {
        min-height: 360px;
        padding: 50px 25px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: #FFFFFF;
        border: 1px solid #E5E7EB;
        border-radius: 20px;
    }


    .client-empty-icon {
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        border-radius: 18px;
        background: #F8F5F2;
        color: #971B1B;
        font-size: 30px;
    }


    .client-empty-state h3 {
        margin: 0 0 8px;
        color: #1F2937;
        font-size: 21px;
    }


    .client-empty-state p {
        max-width: 480px;
        margin: 0 0 22px;
        color: #6B7280;
        font-size: 15px;
        line-height: 1.6;
    }


    .client-empty-upload-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 20px;
        border-radius: 10px;
        background: #D88B2A;
        color: #FFFFFF;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }


    .client-empty-upload-button:hover {
        color: #FFFFFF;
        text-decoration: none;
        opacity: 0.9;
    }


    /* =====================================================
       STAFF / ADMIN DESIGN PAGE
       ===================================================== */

    .staff-design-page {
        width: 100%;
        padding: 8px 0 40px;
    }


    /* =====================================================
       STAFF HEADER
       ===================================================== */

    .staff-design-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 28px;
    }


    .staff-design-heading {
        min-width: 0;
    }


    .staff-page-label {
        display: inline-block;
        margin-bottom: 8px;
        color: #971B1B;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.2px;
    }


    .staff-design-heading h1 {
        margin: 0 0 7px;
        color: #1F2937;
        font-size: 42px;
        font-weight: 750;
        line-height: 1.15;
    }


    .staff-design-heading p {
        margin: 0;
        color: #6B7280;
        font-size: 16px;
        line-height: 1.5;
    }


    /* =====================================================
       STAFF UPLOAD BUTTON
       ===================================================== */

    .staff-upload-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 12px;
        background: #D88B2A;
        color: #FFFFFF;
        text-decoration: none;
        font-size: 15px;
        font-weight: 650;
        white-space: nowrap;
        transition: all 0.2s ease;
    }


    .staff-upload-button:hover {
        color: #FFFFFF;
        text-decoration: none;
        background: #C97E22;
        transform: translateY(-1px);
        box-shadow: 0 5px 14px rgba(216, 139, 42, 0.20);
    }


    .staff-upload-icon {
        font-size: 20px;
        line-height: 1;
    }


    /* =====================================================
       STAFF SEARCH TOOLBAR
       ===================================================== */

    .staff-design-toolbar {
        width: 100%;
        margin-bottom: 34px;
        padding: 18px;
        background: #FFFFFF;
        border: 1px solid #E5E7EB;
        border-radius: 18px;
        box-shadow: 0 2px 8px rgba(31, 41, 55, 0.03);
    }


    .staff-search-form {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
    }


    .staff-search-box {
        flex: 1;
        min-width: 200px;
        height: 48px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 15px;
        border: 1px solid #D1D5DB;
        border-radius: 11px;
        background: #FFFFFF;
        transition: all 0.2s ease;
    }


    .staff-search-box:focus-within {
        border-color: #971B1B;
        box-shadow: 0 0 0 3px rgba(151, 27, 27, 0.07);
    }


    .staff-search-icon {
        color: #6B7280;
        font-size: 21px;
    }


    .staff-search-box input {
        width: 100%;
        height: 100%;
        border: none;
        outline: none;
        background: transparent;
        color: #1F2937;
        font-size: 14px;
    }


    .staff-status-select {
        width: 175px;
        height: 48px;
        padding: 0 13px;
        border: 1px solid #D1D5DB;
        border-radius: 11px;
        background: #FFFFFF;
