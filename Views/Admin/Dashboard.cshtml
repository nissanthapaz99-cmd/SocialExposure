@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Admin Dashboard</h1>

        <p class="lead text-muted">
            Welcome to the Social Exposure Administration Portal
        </p>
    </div>

    <div class="row g-4">

        <!-- User Management -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100 p-4">
                <h2>Users</h2>

                <p class="text-muted">
                    Manage staff and client accounts, roles and
                    account status.
                </p>

                <a href="#" class="btn btn-danger">
                    Manage Users
                </a>
            </div>
        </div>

        <!-- Projects -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100 p-4">
                <h2>Projects</h2>

                <p class="text-muted">
                    View and manage all projects within
                    Social Exposure.
                </p>

                <a asp-controller="Project"
                   asp-action="Index"
                   class="btn btn-danger">
                    Manage Projects
                </a>
            </div>
        </div>

        <!-- Designs -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100 p-4">
                <h2>Designs</h2>

                <p class="text-muted">
                    Manage uploaded designs and their
                    assigned clients.
                </p>

                <a href="#" class="btn btn-danger">
                    Manage Designs
                </a>
            </div>
        </div>

        <!-- Approvals -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100 p-4">
                <h2>Approvals</h2>

                <p class="text-muted">
                    Monitor client feedback and design
                    approval status.
                </p>

                <a href="#" class="btn btn-danger">
                    View Approvals
                </a>
            </div>
        </div>

    </div>

</div>