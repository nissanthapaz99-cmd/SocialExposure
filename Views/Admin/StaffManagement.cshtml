@model IEnumerable<SocialExposure.Models.User>
@{ ViewData["Title"] = "Staff Management"; }
<section class="admin-page">
    <div class="management-header">
        <div><h2>Internal Staff Management</h2><p>Review Staff requests and manage internal accounts</p></div>
        <a class="action-button" asp-action="CreateUser" asp-route-role="Staff">+ Add Staff Member</a>
    </div>
    <div class="people-grid">
    @foreach (var user in Model)
    {
        var initials = string.Join("", user.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
        var status = !user.IsVerified
            ? "Awaiting email verification"
            : !user.IsApproved
                ? (user.IsActive ? "Pending approval" : "Rejected")
                : (user.IsActive ? "Active" : "Suspended");
        <article class="person-card">
            <span class="mini-avatar">@initials</span>
            <div>
                <h3>@user.FullName</h3>
                <span class="account-state @(!user.IsActive || !user.IsApproved ? "inactive" : "")">@status</span>
                <p><strong>@(string.IsNullOrWhiteSpace(user.CompanyName) ? "Department not provided" : user.CompanyName)</strong><br />@user.Email<br />@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "Phone not provided" : user.PhoneNumber)</p>
                @if (!string.IsNullOrWhiteSpace(user.AccessReason))
                {
                    <p class="person-reason"><b>Access reason:</b> @user.AccessReason</p>
                }
                <div class="person-meta">
                    <span class="role-badge @user.Role.ToLowerInvariant()">@user.Role</span>
                    <span>@(string.IsNullOrWhiteSpace(user.JobTitle) ? "Job title not provided" : user.JobTitle)</span>
                    <span>Prefers @(string.IsNullOrWhiteSpace(user.PreferredContactMethod) ? "Email" : user.PreferredContactMethod)</span>
                    <span>@(user.IsVerified ? "Email verified" : "Email verification pending")</span>
                </div>
            </div>
            <div class="person-actions">
                <a asp-action="UserManagement" asp-route-search="@user.Email">View</a>
                @if (user.Role == UserRoles.Staff && user.IsVerified && !user.IsApproved)
                {
                    <form asp-action="ApproveUser" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@user.Id"/><input type="hidden" name="returnTo" value="StaffManagement"/><button type="submit">Approve</button></form>
                    @if (user.IsActive)
                    {
                        <form asp-action="RejectUser" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@user.Id"/><input type="hidden" name="returnTo" value="StaffManagement"/><button type="submit">Reject</button></form>
                    }
                }
                else if (user.IsApproved)
                {
                    <form asp-action="ToggleStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@user.Id"/><input type="hidden" name="returnTo" value="StaffManagement"/><button type="submit">@(user.IsActive ? "Suspend" : "Reactivate")</button></form>
                }
            </div>
        </article>
    }
    </div>
</section>
