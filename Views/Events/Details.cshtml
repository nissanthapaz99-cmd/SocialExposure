@model SocialExposure.Models.Event
@{ ViewData["Title"] = "Event Details"; }
<div class="feature-page">
    <div class="feature-header"><div><h2>Event Details</h2><p>Review the event schedule and project information.</p></div><div class="feature-actions"><a class="action-button secondary" asp-action="Index">← Back to Events</a></div></div>
    <div class="details-grid">
        <article class="detail-tile"><small>Event Name</small><strong>@(Model?.EventName ?? "Event Name")</strong></article>
        <article class="detail-tile"><small>Client</small><strong>@(Model?.ClientName ?? "Client Name")</strong></article>
        <article class="detail-tile"><small>Status</small><span class="status-pill @((Model?.Status ?? "Pending").ToLowerInvariant())">@(Model?.Status ?? "Pending")</span></article>
    </div>
    <section class="feature-section"><h3 class="feature-section-title">Details</h3><div class="detail-list">
        <div class="detail-row"><b>Description</b><span>@(Model?.Description ?? "No description available.")</span></div>
        <div class="detail-row"><b>Start Date</b><span>@(Model == null ? "Not available" : Model.StartDate.ToString("dd MMMM yyyy"))</span></div>
        <div class="detail-row"><b>Deadline</b><span>@(Model == null ? "Not available" : Model.Deadline.ToString("dd MMMM yyyy"))</span></div>
    </div></section>
    <section class="feature-section"><h3 class="feature-section-title">Designs in Event</h3><div class="data-card empty-state"><i>▤</i><h3>No designs uploaded</h3><p>Design files connected to this event will appear here.</p></div></section>
</div>
