@model IEnumerable<SocialExposure.Models.Event>

@{
    ViewData["Title"] = "View Events";
    Layout = "_StaffLayout";
}

<link rel="stylesheet" href="~/css/viewstaff.css" />

<div class="container mt-4">

    <!-- Back -->
    <a asp-controller="Events"
       asp-action="Client"
       class="back-link">
        ← Back to Events
    </a>

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="page-title">
            View Events
        </h1>

    </div>

    <div class="table-card">

        <table class="table">

            <thead>

                <tr>
                    <th>Event Name</th>
                    <th>Client</th>
                    <th>Client Email</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>

            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.EventName
                            </td>

                            <td>
                                @item.ClientName
                            </td>

                            <td>
                                @item.ClientEmail
                            </td>

                            <td>
                                <span class="status">
                                    @item.Status
                                </span>
                            </td>

                            <td class="action-buttons">

                                <a asp-controller="Events"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn-details">
                                    View Details
                                </a>

                                <a asp-controller="Events"
                                   asp-action="Upload"
                                   asp-route-id="@item.Id"
                                   class="btn-upload">
                                    Upload Design
                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5"
                            class="text-center p-5">

                            No Events Found

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>