@model IEnumerable<SocialExposure.Models.Event>

@{
    ViewData["Title"] = "View Events";
    Layout = "_StaffLayout";
}

<link rel="stylesheet" href="~/css/viewstaff.css" />

<div class="events-staff-page">

    <div class="container mt-4">

        <!-- Back -->
        <a asp-controller="Events"
           asp-action="Index"
           class="back-link">
            ← Back to Events
        </a>

        <div class="page-header">

            <h1 class="page-title">
                View Events
            </h1>

            <a asp-controller="Events"
               asp-action="Create"
               class="btn-create">
                + Create Event
            </a>

        </div>

        <div class="table-card">

            <table class="table">

                <thead>
                    <tr>
                        <th>Event Name</th>
                        <th>Client</th>
                        <th>Client Email</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.EventName</td>

                                <td>@item.ClientName</td>

                                <td>@item.ClientEmail</td>

                                <td>
                                    @if (item.Status == "Completed")
                                    {
                                        <span class="status-badge completed">
                                            @item.Status
                                        </span>
                                    }
                                    else if (item.Status == "Active")
                                    {
                                        <span class="status-badge active">
                                            @item.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge pending">
                                            @item.Status
                                        </span>
                                    }
                                </td>

                                <td class="action-buttons">

                                    <a asp-controller="Events"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn-details">
                                        View Details
                                    </a>

                                    <a asp-controller="Events"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn-edit">
                                        Edit
                                    </a>

                                    <a asp-controller="Events"
                                       asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn-delete">
                                        Delete
                                    </a>

                                    <a asp-controller="Events"
                                       asp-action="Upload"
                                       asp-route-id="@item.Id"
                                       class="btn-upload">
                                        Upload Design
                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5"
                                class="no-events">

                                No Events Found

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>