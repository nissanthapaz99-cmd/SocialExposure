@model SocialExposure.Models.Event
@{ ViewData["Title"] = "Edit Event"; }
<div class="form-card">
    <div class="form-card-header"><h2>Edit Event</h2><p>Update event details, schedule and status.</p></div>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()<input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="field-error"></div>
        <div class="field-grid">
            <div class="field"><label asp-for="EventName">Event Name</label><input asp-for="EventName" /><span asp-validation-for="EventName" class="field-error"></span></div>
            <div class="field"><label asp-for="ClientName">Client Name</label><input asp-for="ClientName" /><span asp-validation-for="ClientName" class="field-error"></span></div>
        </div>
        <div class="field"><label asp-for="ClientEmail">Client Email</label><input asp-for="ClientEmail" /><span asp-validation-for="ClientEmail" class="field-error"></span></div>
        <div class="field"><label asp-for="Description">Description</label><textarea asp-for="Description"></textarea><span asp-validation-for="Description" class="field-error"></span></div>
        <div class="field-grid">
            <div class="field"><label asp-for="StartDate">Start Date</label><input asp-for="StartDate" type="date" /></div>
            <div class="field"><label asp-for="Deadline">Deadline</label><input asp-for="Deadline" type="date" /></div>
        </div>
        <div class="field"><label asp-for="Status">Status</label><select asp-for="Status"><option>Pending</option><option>Completed</option></select></div>
        <div class="form-actions"><button class="action-button" type="submit">Save Changes</button><a class="action-button secondary" asp-action="ViewStaff">Cancel</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
