@model SocialExposure.Models.Event
@{ ViewData["Title"] = "Create Event"; }

<div class="form-card">
    <div class="form-card-header"><h2>Create Event</h2><p>Add an event and connect it with a client.</p></div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="field-error"></div>
        <div class="field-grid">
            <div class="field"><label asp-for="EventName">Event Name</label><input asp-for="EventName" placeholder="Enter event name" /><span asp-validation-for="EventName" class="field-error"></span></div>
            <div class="field"><label asp-for="ClientName">Client Name</label><input asp-for="ClientName" placeholder="Enter client name" /><span asp-validation-for="ClientName" class="field-error"></span></div>
        </div>
        <div class="field"><label asp-for="ClientEmail">Client Email</label><input asp-for="ClientEmail" placeholder="client@company.com" /><small class="field-note">The event will be shown to the client who uses this email.</small><span asp-validation-for="ClientEmail" class="field-error"></span></div>
        <div class="field"><label asp-for="Description">Description</label><textarea asp-for="Description" placeholder="Describe the event and deliverables"></textarea><span asp-validation-for="Description" class="field-error"></span></div>
        <div class="field-grid">
            <div class="field"><label asp-for="StartDate">Start Date</label><input asp-for="StartDate" type="date" /><span asp-validation-for="StartDate" class="field-error"></span></div>
            <div class="field"><label asp-for="Deadline">Deadline</label><input asp-for="Deadline" type="date" /><span asp-validation-for="Deadline" class="field-error"></span></div>
        </div>
        <div class="form-actions"><button class="action-button" type="submit">Create Event</button><a class="action-button secondary" asp-action="Index">Cancel</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
