@model IEnumerable<SocialExposure.Models.Event>
@using System.Security.Claims
@{
    ViewData["Title"] = "Events";
    var events = Model?.ToList() ?? new List<SocialExposure.Models.Event>();
    var role = User.FindFirstValue(ClaimTypes.Role) ?? UserRoles.Client;
    var canManage = role is UserRoles.Admin or UserRoles.Staff;
}

<div class="feature-page">
    <div class="feature-header">
        <div>
            <h2>Events</h2>
            <p>Track client events, deadlines and design activity.</p>
        </div>
        <div class="feature-actions">
            @if (canManage)
            {
                <a class="action-button" asp-action="Create">+ Create Event</a>
                <a class="action-button secondary" asp-action="ViewStaff">View Events</a>
            }
            else
            {
                <a class="action-button secondary" asp-action="ViewClient">View My Events</a>
            }
        </div>
    </div>

    <div class="summary-grid">
        <article class="summary-tile"><i class="summary-tile-icon">□</i><strong>@events.Count</strong><span>Total Events</span></article>
        <article class="summary-tile"><i class="summary-tile-icon">↗</i><strong>@events.Count(e => e.Status != "Incomplete")</strong><span>Active Events</span></article>
        <article class="summary-tile"><i class="summary-tile-icon">◷</i><strong>@events.Count(e => e.Status == "Pending")</strong><span>Pending</span></article>
        <article class="summary-tile"><i class="summary-tile-icon">✓</i><strong>@events.Count(e => e.Status == "Completed")</strong><span>Completed</span></article>
    </div>

    <section class="feature-section data-card">
        <div class="data-card-header"><h3>Recent Events</h3></div>
        <div class="data-table-wrap">
            <table class="data-table">
                <thead><tr><th>Event Name</th><th>Client</th><th>Status</th><th>Start Date</th></tr></thead>
                <tbody>
                @if (events.Count > 0)
                {
                    foreach (var item in events.OrderByDescending(e => e.Id).Take(5))
                    {
                        <tr><td><strong>@item.EventName</strong></td><td>@item.ClientName</td><td><span class="status-pill @item.Status.ToLowerInvariant()">@item.Status</span></td><td>@item.StartDate.ToString("dd MMM yyyy")</td></tr>
                    }
                }
                else
                {
                    <tr><td colspan="4"><div class="empty-state"><i>□</i><h3>No events yet</h3><p>Events will appear here once they are created.</p></div></td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
