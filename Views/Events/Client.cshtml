@model IEnumerable<SocialExposure.Models.Event>
@{ ViewData["Title"] = "Events"; var events = Model?.ToList() ?? new List<SocialExposure.Models.Event>(); }
<div class="feature-page">
    <div class="feature-header"><div><h2>My Events</h2><p>Keep track of your active work and upcoming deadlines.</p></div><div class="feature-actions"><a class="action-button secondary" asp-action="ViewClient">View All Events</a></div></div>
    <div class="summary-grid">
        <article class="summary-tile"><i class="summary-tile-icon">□</i><strong>@events.Count</strong><span>Total Events</span></article>
        <article class="summary-tile"><i class="summary-tile-icon">↗</i><strong>@events.Count(e => e.Status == "Active")</strong><span>Active</span></article>
        <article class="summary-tile"><i class="summary-tile-icon">◷</i><strong>@events.Count(e => e.Status == "Pending")</strong><span>Pending</span></article>
        <article class="summary-tile"><i class="summary-tile-icon">✓</i><strong>@events.Count(e => e.Status == "Completed")</strong><span>Completed</span></article>
    </div>
    <section class="feature-section data-card"><div class="data-card-header"><h3>Recent Events</h3></div><div class="empty-state"><i>□</i><h3>@(events.Count == 0 ? "No events yet" : $"{events.Count} events available")</h3><p>Your assigned client events are shown in the full events view.</p></div></section>
</div>
