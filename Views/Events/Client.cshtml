@model IEnumerable<SocialExposure.Models.Event>

@{
    ViewData["Title"] = "Events";
 Layout = "_StaffLayout";
    var totalEvents = Model?.Count() ?? 0;
    var activeEvents = Model?.Count(e => e.Status == "Active") ?? 0;
    var pendingEvents = Model?.Count(e => e.Status == "Pending") ?? 0;
    var completedEvents = Model?.Count(e => e.Status == "Completed") ?? 0;
}
<link rel="stylesheet" href="~/css/event.css" />

<div class="container-fluid">

    <div class="content">

        <h1 class="page-title">Events</h1>

        <!-- Buttons -->
        <div class="mb-5">

            <a asp-controller="Events"
               asp-action="ViewClient"
               class="btn-view">
                View Events
            </a>

        </div>


        <!-- Summary -->
        <h2 class="section-title">Summary</h2>

        <div class="row">

            <!-- Total Events -->
            <div class="col-lg-3 col-md-6 mb-4">

                <div class="summary-card">

                    <div class="summary-icon">
                        📅
                    </div>

                    <h2>@totalEvents</h2>

                    <p>Total Events</p>

                </div>

            </div>


            <!-- Active Events -->
            <div class="col-lg-3 col-md-6 mb-4">

                <div class="summary-card">

                    <div class="summary-icon">
                        📈
                    </div>

                    <h2>@activeEvents</h2>

                    <p>Active Events</p>

                </div>

            </div>


            <!-- Pending Events -->
            <div class="col-lg-3 col-md-6 mb-4">

                <div class="summary-card">

                    <div class="summary-icon">
                        🕒
                    </div>

                    <h2>@pendingEvents</h2>

                    <p>Pending</p>

                </div>

            </div>
            <!-- Completed Events -->
            <div class="col-lg-3 col-md-6 mb-4">

                <div class="summary-card">

                    <div class="summary-icon">
                        ✅
                    </div>

                    <h2>@completedEvents</h2>

                    <p>Completed</p>

                </div>

            </div>

        </div>


        <!-- Recent Events -->
        <h3 class="section-title">Recent Events</h3>

        <div class="table-card">

            <table class="table">

                <thead>

                    <tr>

                        <th>Event Name</th>
                        <th>Client</th>
                        <th>Status</th>
                        <th>Date</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model.OrderByDescending(e => e.Id).Take(5))
                        {
                            <tr>

                                <td>
                                    @item.EventName
                                </td>

                                <td>
                                    @item.ClientName
                                </td>

                                <td>
                                    <span class="badge bg-warning">
                                        @item.Status
                                    </span>
                                </td>

                                <td>
                                    @item.StartDate.ToString("dd/MM/yyyy")
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="4" class="text-center p-5">
                                No Events Found
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>