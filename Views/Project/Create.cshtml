@model SocialExposure.Models.Project
@{ ViewData["Title"] = "Create Project"; }

<div class="form-card">
    <div class="form-card-header"><h2>Create Project</h2><p>Create a new project and assign it to an active client.</p></div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="field-error"></div>
        <div class="field"><label asp-for="ProjectName">Project Name</label><input asp-for="ProjectName" placeholder="Enter project name" /><span asp-validation-for="ProjectName" class="field-error"></span></div>
        <div class="field"><label asp-for="Description">Description</label><textarea asp-for="Description" placeholder="Describe the project"></textarea><span asp-validation-for="Description" class="field-error"></span></div>
        <div class="field"><label asp-for="ClientId">Assign Client</label><select asp-for="ClientId"><option value="">Select a client</option>@foreach (var client in ViewBag.Clients) { <option value="@client.Id">@client.FullName — @client.Email</option> }</select><span asp-validation-for="ClientId" class="field-error"></span></div>
        <div class="form-actions"><button class="action-button" type="submit">Create Project</button><a class="action-button secondary" asp-action="Index">Cancel</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
