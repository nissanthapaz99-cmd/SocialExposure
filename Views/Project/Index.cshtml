@model IEnumerable<SocialExposure.Models.Project>
@{
    ViewData["Title"] = "Projects";
    var clients = ViewBag.Clients as List<SocialExposure.Models.User>;
    var projects = Model?.ToList() ?? new List<SocialExposure.Models.Project>();
}

<div class="feature-page">
    <div class="feature-header">
        <div><h2>Projects</h2><p>Manage Social Exposure client projects.</p></div>
        <div class="feature-actions"><a class="action-button" asp-action="Create">+ Create Project</a></div>
    </div>

    @if (projects.Count == 0)
    {
        <div class="data-card empty-state"><i>◇</i><h3>No projects yet</h3><p>Create a project and assign it to an active client.</p></div>
    }
    else
    {
        <div class="project-grid">
        @foreach (var project in projects)
        {
            var client = clients?.FirstOrDefault(x => x.Id == project.ClientId);
            <article class="project-card">
                <div class="data-card-header" style="padding:0 0 14px;border:0"><h3>@project.ProjectName</h3><span class="status-pill @project.Status.ToLowerInvariant()">@project.Status</span></div>
                <p>@project.Description</p>
                <div class="project-meta"><div><b>Client:</b> <span>@(client?.FullName ?? "Client not found")</span></div><div><b>Created:</b> <span>@project.CreatedDate.ToString("dd MMM yyyy")</span></div></div>
            </article>
        }
        </div>
    }
</div>
