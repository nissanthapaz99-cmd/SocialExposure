@model SocialExposure.ViewModels.AirtableIntegrationViewModel
@{
    ViewData["Title"] = "Airtable Sync";
    var last = Model.LastResult;
}

<section class="airtable-page">
    <div class="management-header">
        <div>
            <h2>Airtable Integration</h2>
            <p>Two-way synchronization for clients, events and design records.</p>
        </div>
        @if (Model.IsConfigured)
        {
            <form asp-action="Sync" method="post">
                @Html.AntiForgeryToken()
                <button class="action-button peach" type="submit" disabled="@Model.IsRunning">
                    @(Model.IsRunning ? "Syncing…" : "Sync Now")
                </button>
            </form>
        }
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="success-message">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="airtable-alert error">@error</div>
    }

    <div class="airtable-status-grid">
        <article class="airtable-status-card">
            <span class="airtable-status-dot @(Model.IsConfigured ? "connected" : "not-connected")"></span>
            <div>
                <small>Connection</small>
                <strong>@(Model.IsConfigured ? "Configured" : Model.Enabled ? "Missing settings" : "Disabled")</strong>
                <p>The access token is stored privately and is never displayed here.</p>
            </div>
        </article>
        <article class="airtable-status-card">
            <div>
                <small>Base</small>
                <strong>@(string.IsNullOrWhiteSpace(Model.BaseId) ? "Not configured" : Model.BaseId)</strong>
                <p>Automatic sync runs every @Model.SyncIntervalMinutes minute(s).</p>
            </div>
        </article>
        <article class="airtable-status-card">
            <div>
                <small>Tables</small>
                <strong>@Model.ClientsTable · @Model.EventsTable · @Model.DesignsTable</strong>
                <p>Website IDs link each Airtable record to the correct local record.</p>
            </div>
        </article>
    </div>

    @if (last != null)
    {
        <section class="panel airtable-results">
            <div class="panel-heading">
                <h3>Latest Sync</h3>
                <span class="account-state @(last.IsSuccessful ? "" : "inactive")">
                    @(last.IsSuccessful ? "Completed" : last.IsBusy ? "Already running" : "Needs attention")
                </span>
            </div>
            <p>@last.Message</p>
            <div class="airtable-result-stats">
                <div><b>@last.Imported</b><span>Imported</span></div>
                <div><b>@last.Exported</b><span>Exported</span></div>
                <div><b>@last.Conflicts</b><span>Website won</span></div>
                <div><b>@last.Skipped</b><span>Skipped</span></div>
            </div>
            @if (last.CompletedAtUtc.HasValue)
            {
                <small>Finished @last.CompletedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</small>
            }
            @if (last.Warnings.Any())
            {
                <div class="airtable-warning-list">
                    <strong>Items requiring attention</strong>
                    <ul>
                        @foreach (var warning in last.Warnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }
        </section>
    }

    <div class="airtable-columns">
        <section class="panel">
            <div class="panel-heading"><h3>Required Airtable tables</h3></div>
            <div class="airtable-table-spec">
                <h4>@Model.ClientsTable</h4>
                <p>Website ID, Full Name, Email, Company Name, Phone Number, Job Title, Preferred Contact, Account Status, Created At</p>
                <h4>@Model.EventsTable</h4>
                <p>Website ID, Event Name, Client Name, Client Email, Description, Start Date, Deadline, Status</p>
                <h4>@Model.DesignsTable</h4>
                <p>Website ID, File Name, File URL, Description, Version, Uploaded At, Event ID, Client ID, Status</p>
            </div>
        </section>

        <section class="panel">
            <div class="panel-heading"><h3>Safety rules</h3></div>
            <ul class="airtable-safety-list">
                <li>Passwords are never sent to Airtable.</li>
                <li>Airtable cannot change roles, verification, approval or suspension.</li>
                <li>New Airtable clients enter the website as unverified, unapproved clients.</li>
                <li>When both copies change before a sync, the website copy wins.</li>
                <li>Deleting an Airtable row does not delete website data.</li>
            </ul>
        </section>
    </div>
</section>
