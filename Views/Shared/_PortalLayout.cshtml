@using System.Security.Claims
@using SocialExposure.Models
@inject SocialExposure.Data.ApplicationDbContext Db

@{
    var controller =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var action =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var title =
        ViewData["Title"]?.ToString() ?? controller;

    var displayName =
        User.Identity?.Name ?? "User";

    var role =
        User.FindFirstValue(ClaimTypes.Role)
        ?? UserRoles.Client;

    var initials = string.Join(
        "",
        displayName
            .Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(
                x => char.ToUpperInvariant(x[0]))
    );

    var fullBleed =
        ViewData["PortalFullBleed"] as bool? == true;

    var userId =
        int.TryParse(
            User.FindFirstValue(ClaimTypes.NameIdentifier),
            out var parsedUserId)
            ? parsedUserId
            : 0;

    var unreadNotifications =
        userId == 0
            ? 0
            : Db.Notifications.Count(
                x => x.UserId == userId && !x.IsRead);

    var unreadMessages =
        userId == 0
            ? 0
            : Db.Messages.Count(
                x => x.ReceiverId == userId && !x.IsRead);

    var isAdmin =
        role == UserRoles.Admin;

    var isStaff =
        role == UserRoles.Staff;
    var pendingClientApprovals = isAdmin
        ? Db.Users.Count(x => x.Role == UserRoles.Client && x.IsVerified && x.IsActive && !x.IsApproved)
        : 0;
    var pendingStaffApprovals = isAdmin
        ? Db.Users.Count(x => x.Role == UserRoles.Staff && x.IsVerified && x.IsActive && !x.IsApproved)
        : 0;

    string Active(
        string targetController,
        string targetAction = "")
    {
        return controller == targetController &&
               (
                   string.IsNullOrEmpty(targetAction) ||
                   action == targetAction
               )
            ? "active"
            : "";
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>
        @title - Social Exposure
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/portal.css"
          asp-append-version="true" />

    @await RenderSectionAsync(
        "Styles",
        required: false)

</head>

<body class="role-@role.ToLowerInvariant()">

<div class="portal-shell">

    <!-- =========================================
         SIDEBAR
         ========================================= -->

    <aside class="portal-sidebar">

        <!-- LOGO -->

        <a class="portal-logo"
           asp-controller="Home"
           asp-action="Index">

            <img src="~/images/logo-white.png"
                 alt="Social Exposure Events"
                 class="portal-logo-img" />

        </a>


        <!-- USER -->

        @if (isAdmin)
        {
            <div class="portal-user admin-user">

                <div class="role-symbol">
                    ♢
                </div>

                <div>

                    <b>
                        Admin Panel
                    </b>

                    <span>
                        Full Access
                    </span>

                </div>

            </div>
        }
        else
        {
            <div class="portal-user">

                <div class="portal-avatar soft">
                    @initials
                </div>

                <div>

                    <b>
                        @displayName
                    </b>

                    <span>
                        @if (isStaff)
                        {
                            <text>Staff Member</text>
                        }
                        else
                        {
                            <text>Client</text>
                        }
                    </span>

                </div>

            </div>
        }


        <!-- =========================================
             NAVIGATION
             ========================================= -->

        <nav class="portal-nav"
             aria-label="Portal navigation">


            <!-- =====================================
                 ADMIN
                 ===================================== -->

            @if (isAdmin)
            {
                <a class="@Active("Admin", "Dashboard")"
                   asp-controller="Admin"
                   asp-action="Dashboard">

                    Dashboard

                </a>


                <a class="@Active("Admin", "UserManagement")"
                   asp-controller="Admin"
                   asp-action="UserManagement">

                    User Management

                </a>


                <a class="@Active("Admin", "StaffManagement")"
                   asp-controller="Admin"
                   asp-action="StaffManagement">

                    Staff Management @if(pendingStaffApprovals > 0){<em title="Pending Staff requests">@pendingStaffApprovals</em>}

                </a>


                <a class="@Active("Admin", "ClientManagement")"
                   asp-controller="Admin"
                   asp-action="ClientManagement">

                    Client Management @if(pendingClientApprovals > 0){<em title="Pending signup requests">@pendingClientApprovals</em>}

                </a>


                <a class="@Active("Notification")"
                   asp-controller="Notification"
                   asp-action="Index">

                    Notifications

                    @if (unreadNotifications > 0)
                    {
                        <em>
                            @unreadNotifications
                        </em>
                    }

                </a>


                <a class="@Active("Message")"
                   asp-controller="Message"
                   asp-action="Index">

                    Messages

                    @if (unreadMessages > 0)
                    {
                        <em>
                            @unreadMessages
                        </em>
                    }

                </a>


                <a class="@Active("Admin", "ActivityLogs")"
                   asp-controller="Admin"
                   asp-action="ActivityLogs">

                    Activity Logs

                </a>
            }


            <!-- =====================================
                 STAFF
                 ===================================== -->

            @if (isStaff && !isAdmin)
            {
                <a class="@Active("Staff")"
                   asp-controller="Staff"
                   asp-action="Dashboard">

                    Dashboard

                </a>


                <a class="@Active("Events")"
                   asp-controller="Events"
                   asp-action="Index">

                    Events

                </a>


                <a class="@Active("Design")"
                   asp-controller="Design"
                   asp-action="Index">

                    Designs

                </a>


                <a class="@Active("Notification")"
                   asp-controller="Notification"
                   asp-action="Index">

                    Notifications

                    @if (unreadNotifications > 0)
                    {
                        <em>
                            @unreadNotifications
                        </em>
                    }

                </a>


                <a class="@Active("Message")"
                   asp-controller="Message"
                   asp-action="Index">

                    Messages

                    @if (unreadMessages > 0)
                    {
                        <em>
                            @unreadMessages
                        </em>
                    }

                </a>
            }


            <!-- =====================================
                 CLIENT
                 ===================================== -->

            @if (!isAdmin && !isStaff)
            {
                <!-- EVENTS -->

                <a class="@(controller == "Client" || controller == "Events"
                              ? "active"
                              : "")"
                   asp-controller="Client"
                   asp-action="Dashboard">

                    Events

                </a>


                <!-- DESIGNS -->

                <a class="@Active("Design")"
                   asp-controller="Design"
                   asp-action="Index">

                    Designs

                </a>


                <!-- NOTIFICATIONS -->

                <a class="@Active("Notification")"
                   asp-controller="Notification"
                   asp-action="Index">

                    Notifications

                    @if (unreadNotifications > 0)
                    {
                        <em>
                            @unreadNotifications
                        </em>
                    }

                </a>


                <!-- MESSAGES -->

                <a class="@Active("Message")"
                   asp-controller="Message"
                   asp-action="Index">

                    Messages

                    @if (unreadMessages > 0)
                    {
                        <em>
                            @unreadMessages
                        </em>
                    }

                </a>


                <!-- PROFILE -->

                <a class="@Active("Account", "Profile")"
                   asp-controller="Account"
                   asp-action="Profile">

                    Profile

                </a>
            }

        </nav>


        <!-- =========================================
             LOGOUT
             ========================================= -->

        <form class="portal-logout"
              asp-controller="Account"
              asp-action="Logout"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit">

                <i>
                    ⇥
                </i>

                Logout

            </button>

        </form>

    </aside>


    <!-- =========================================
         WORKSPACE
         ========================================= -->

    <section class="portal-workspace">


        <!-- TOP BAR -->

        <header class="portal-topbar">

            <button class="portal-menu"
                    type="button"
                    aria-label="Toggle navigation">

                ☰

            </button>


            <div class="portal-heading">

                <h1>
                    @title
                </h1>

                @if (isAdmin)
                {
                    <p>
                        Social Exposure Admin Panel
                    </p>
                }

            </div>


            <div class="portal-top-actions">

                <a class="portal-bell"
                   asp-controller="Notification"
                   asp-action="Index"
                   aria-label="Notifications">

                    <i class="bi bi-bell"></i>

                    @if (unreadNotifications > 0)
                    {
                        <b>
                            @unreadNotifications
                        </b>
                    }

                </a>


                @if (isAdmin)
                {
                    <div class="top-user-copy">

                        <strong>
                            @displayName
                        </strong>

                        <span>
                            Administrator
                        </span>

                    </div>
                }


                <a class="portal-avatar portal-avatar-link"
                   asp-controller="Account"
                   asp-action="Profile">

                    @initials

                </a>

            </div>

        </header>


        <!-- PAGE CONTENT -->

        <main class="portal-content @(fullBleed ? "full-bleed" : "")">

            @RenderBody()

        </main>

    </section>

</div>


<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
</script>


<script>

    document
        .querySelector('.portal-menu')
        ?.addEventListener(
            'click',
            function () {

                document.body.classList.toggle(
                    'portal-nav-open'
                );

            }
        );

</script>


@await RenderSectionAsync(
    "Scripts",
    required: false)

</body>

</html>