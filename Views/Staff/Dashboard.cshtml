@model IEnumerable<SocialExposure.Models.Event>

@{
    ViewData["Title"] = "Dashboard";
    var events = Model?.ToList() ?? new List<SocialExposure.Models.Event>();
    var activeEvents = events.Count(e => e.Status != "Completed");
}

<section class="dashboard-page">

    <div class="page-intro">
        <div><h2>Welcome back, @User.Identity?.Name! 👋</h2><p>Here's what's happening with your projects today.</p></div>
    </div>

    <div class="quick-actions">
        <a class="peach" asp-controller="Events" asp-action="Index">⇧ Upload Design</a>
        <a asp-controller="Events" asp-action="Create">＋ Create Events</a>
        <a class="gold" asp-controller="Project" asp-action="Index">➤ Send for Approval</a>
    </div>

    <div class="stat-grid four">
        <article><i>📅</i><b>@activeEvents</b><span>Active Events</span></article>
        <article><i>◷</i><b>0</b><span>Pending Approvals</span></article>
        <article><i>♧</i><b>0</b><span>Feedback Received</span></article>
        <article><i>!</i><b>0</b><span>Overdue Tasks</span></article>
    </div>

    <div class="dashboard-columns">

        <section class="panel">
            <div class="panel-heading">
                <h3>Assigned Projects</h3>
                <a asp-controller="Events" asp-action="ViewStaff">View All →</a>
            </div>

            @if (events.Any(e => e.Status != "Completed"))
            {
                <div class="project-preview">
                    @foreach (var item in events.Where(e => e.Status != "Completed").OrderByDescending(e => e.Id).Take(5))
                    {
                        <div style="margin-bottom:20px;">
                            <h4>@item.EventName</h4>
                            <p>Client: @item.ClientName<br />Status: @item.Status<br />Deadline: @item.Deadline.ToString("dd MMM yyyy")</p>
                            <a class="text-link" asp-controller="Events" asp-action="Details" asp-route-id="@item.Id">View Details</a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="project-preview">
                    <h4>No active projects</h4>
                    <p>Active events will appear here.</p>
                    <a class="text-link" asp-controller="Events" asp-action="Create">Create Event</a>
                </div>
            }
        </section>

        <aside class="panel">
            <div class="panel-heading"><h3>Pending Tasks</h3></div>
            <div class="task-list">
                <a asp-controller="Design" asp-action="Index"><b>Upload Design</b><span>Add the next design version</span></a>
                <a asp-controller="Message" asp-action="Index"><b>Respond to Messages</b><span>Check client conversations</span></a>
                <a asp-controller="Notification" asp-action="Index"><b>Review Updates</b><span>Open notifications</span></a>
            </div>
        </aside>

    </div>

</section>