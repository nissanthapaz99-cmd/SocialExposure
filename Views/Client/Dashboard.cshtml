@{
    ViewData["Title"] = "Client Dashboard";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">Client Dashboard</h1>
        <p class="text-secondary">
            Welcome to Social Exposure Design Platform
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100">
                <h3>My Designs</h3>
                <p>View designs assigned to you.</p>
                <button class="btn btn-primary">
                    View Designs
                </button>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100">
                <h3>Feedback</h3>
                <p>Provide feedback on your designs.</p>
                <button class="btn btn-primary">
                    Give Feedback
                </button>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100">
                <h3>Approvals</h3>
                <p>Review and approve your designs.</p>
                <button class="btn btn-primary">
                    View Approvals
                </button>
            </div>
        </div>

    </div>

</div>