@{ ViewData["Title"] = "Events"; }
<section class="dashboard-page client-dashboard">
    <div class="client-title-row"><h2>My Events</h2><a class="se-portal-button peach" asp-controller="Events" asp-action="ViewClient">◉&nbsp; View Events</a></div>
    <h3 class="section-title">Summary</h3>
    <div class="stat-grid four">
        <article><i>□</i><b>2</b><span>Total Events</span></article>
        <article><i>↗</i><b>2</b><span>Active Events</span></article>
        <article><i>◷</i><b>1</b><span>Pending</span></article>
        <article><i>✓</i><b>0</b><span>Completed</span></article>
    </div>
    <h3 class="section-title recent-title">Recent Events</h3>
    <div class="data-card"><div class="data-table-wrap"><table class="data-table client-events-table">
        <thead><tr><th>Event Name</th><th>Client</th><th>Status</th><th>Date</th></tr></thead>
        <tbody>
            <tr><td><strong>Spring Campaign Launch</strong></td><td>Acme Corp</td><td><span class="status-pill">In Progress</span></td><td>May 5, 2026</td></tr>
            <tr><td><strong>Website Refresh</strong></td><td>Acme Corp</td><td><span class="status-pill pending">Pending</span></td><td>May 2, 2026</td></tr>
        </tbody>
    </table></div></div>
</section>
