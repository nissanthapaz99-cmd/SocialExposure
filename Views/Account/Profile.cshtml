@model SocialExposure.Models.User
@{ ViewData["Title"] = "Profile";    Layout = "~/Views/Shared/_PortalLayout.cshtml"; var initials=string.Join("",Model.FullName.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>char.ToUpperInvariant(x[0]))); }
<section class="feature-page">
    <div class="feature-header"><div><h2>My Profile</h2><p>Review your Social Exposure account information.</p></div></div>
    <div class="form-card" style="margin:0">
        <div class="user-cell" style="margin-bottom:24px"><span class="mini-avatar" style="width:64px;height:64px">@initials</span><div><h3 style="margin:0 0 5px">@Model.FullName</h3><span class="role-badge @Model.Role.ToLowerInvariant()">@Model.Role</span></div></div>
        <div class="detail-list">
            <div class="detail-row"><b>Email Address</b><span>@Model.Email</span></div>
            @if (Model.Role == UserRoles.Client || Model.Role == UserRoles.Staff)
            {
                <div class="detail-row"><b>Company / Organisation</b><span>@(string.IsNullOrWhiteSpace(Model.CompanyName) ? "Not provided" : Model.CompanyName)</span></div>
                <div class="detail-row"><b>Phone Number</b><span>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</span></div>
                <div class="detail-row"><b>Job Title</b><span>@(string.IsNullOrWhiteSpace(Model.JobTitle) ? "Not provided" : Model.JobTitle)</span></div>
                <div class="detail-row"><b>Preferred Contact</b><span>@(string.IsNullOrWhiteSpace(Model.PreferredContactMethod) ? "Email" : Model.PreferredContactMethod)</span></div>
                <div class="detail-row"><b>Reason for Access</b><span class="detail-long-text">@(string.IsNullOrWhiteSpace(Model.AccessReason) ? "Not provided" : Model.AccessReason)</span></div>
            }
            <div class="detail-row"><b>Account Status</b><span>@(Model.IsActive ? "Active" : "Suspended")</span></div>
            <div class="detail-row"><b>Verification</b><span>@(Model.IsVerified ? "Verified" : "Pending")</span></div>
            @if (Model.Role == UserRoles.Client || Model.Role == UserRoles.Staff)
            {
                <div class="detail-row"><b>Approval</b><span>@(Model.IsApproved ? "Approved" : "Pending administrator approval")</span></div>
                <div class="detail-row"><b>Registered</b><span>@(Model.CreatedAt.HasValue ? Model.CreatedAt.Value.ToLocalTime().ToString("dd MMM yyyy") : "Existing account")</span></div>
            }
        </div>
    </div>
</section>
