@model SocialExposure.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Client Sign Up"; ViewData["CompactHeader"] = true; }
<section class="auth-page">
    <div class="auth-card">
        <div class="auth-icon">♙</div><h1>Create Client Account</h1><p class="lead">Sign up to review designs and collaborate with the team</p>
        <div asp-validation-summary="ModelOnly"></div>
        <form asp-action="Register" method="post">
            <div class="field"><label asp-for="FullName">Full Name</label><input asp-for="FullName" placeholder="Your full name"/><span asp-validation-for="FullName"></span></div>
            <div class="field"><label asp-for="Email">Email Address</label><input asp-for="Email" placeholder="your.email@company.com"/><span asp-validation-for="Email"></span></div>
            <label class="terms"><input asp-for="AcceptTerms"/><span>I agree to the Terms & Conditions</span></label>
            <button class="se-button peach auth-submit" type="submit">Send Verification Code</button>
        </form>
    </div>
    <a class="auth-back" asp-action="Login">← Back to Client Login</a>
</section>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
