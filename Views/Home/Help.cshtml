@{
    ViewData["Title"] = "Help";
}

<section class="public-info-page">
    <a class="info-back-button"
   asp-controller="Account"
   asp-action="Login">
    ← Back to Login
</a>
    <div class="info-heading">
        <h1>Help Center</h1>
        <p>Find simple answers about using Social Exposure.</p>
    </div>

    <div class="info-card">
        <div class="help-item">
            <h3>How do I create an account?</h3>
            <p>Choose Sign Up from the home page and enter your account details.</p>
        </div>

        <div class="help-item">
            <h3>How do I log in?</h3>
            <p>Select Login and enter your registered email and password.</p>
        </div>

        <div class="help-item">
            <h3>Where can I see my events?</h3>
            <p>After logging in, open Events to view your assigned events.</p>
        </div>

        <div class="help-item">
            <h3>How can I view a design?</h3>
            <p>Open the Designs section after logging in to see available design files.</p>
        </div>

        <div class="help-item">
            <h3>Need more help?</h3>
            <p>Visit the Contact page to get in touch with the Social Exposure team.</p>
        </div>
    </div>
</section>