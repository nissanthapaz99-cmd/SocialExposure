@{
    ViewData["Title"] = "Privacy Policy";
}

<!-- Header & Back Button Section -->
<div class="mb-4">
    <a href="javascript:history.back()" class="btn btn-outline-danger rounded-pill px-4 mb-3" style="border-color: #7c2629; color: #7c2629;">
        &larr; Back
    </a>
    <h1 class="display-4 fw-bold" style="color: #7c2629;">Privacy Policy</h1>
    <p class="text-secondary fs-5">Understanding how Social Exposure handles and protects your data.</p>
</div>

<!-- Main White Card Container -->
<div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border mb-5" style="border-radius: 16px;">
    
    <p class="fs-5 text-secondary mb-4 pb-3 border-bottom">
        Social Exposure is committed to protecting your personal data. We comply with the Australian Privacy Principles under the <em>Privacy Act 1988</em> (Cth) and the General Data Protection Regulation (GDPR).
    </p>

    <!-- Section 1 -->
    <div class="py-3 border-bottom">
        <h4 class="fw-bold mb-3" style="color: #7c2629;">1. Data We Collect &amp; Lawful Basis</h4>
        <p class="text-secondary mb-3">We process your personal data on the following legal grounds:</p>
        <ul class="text-secondary lh-lg mb-0">
            <li class="mb-2"><strong>Communication Data:</strong> Names, contact details, and message contents sent via forms or social media to respond to inquiries and maintain records <em>(Legitimate Interest)</em>.</li>
            <li class="mb-2"><strong>Customer &amp; Financial Data:</strong> Purchase history, contact information, and billing details processed via secure third-party payment providers to fulfill orders <em>(Contract Performance)</em>.</li>
            <li class="mb-2"><strong>User &amp; Technical Data:</strong> IP addresses, browser info, analytics, usage patterns, and account details to operate, secure, and improve our site <em>(Legitimate Interest)</em>.</li>
            <li class="mb-2"><strong>Marketing Data:</strong> Communication preferences and newsletter sign-ups to deliver updates and promotional material <em>(Consent / Legitimate Interest)</em>.</li>
            <li class="mb-2"><strong>Sensitive Data:</strong> We do not collect sensitive data (such as health, racial, political, or biometric information).</li>
        </ul>
    </div>

    <!-- Section 2 -->
    <div class="py-3 border-bottom">
        <h4 class="fw-bold mb-3" style="color: #7c2629;">2. Cookies &amp; Analytics</h4>
        <p class="text-secondary lh-lg mb-0">We use session and persistent cookies (including analytics tracking) to enhance site functionality and measure traffic. You can manage or block cookies through your browser settings.</p>
    </div>

    <!-- Section 3 -->
    <div class="py-3 border-bottom">
        <h4 class="fw-bold mb-3" style="color: #7c2629;">3. Data Sharing</h4>
        <p class="text-secondary lh-lg mb-0">We do not sell your personal data. We only share information with IT service providers, professional advisers, government bodies, or payment processors under strict confidentiality.</p>
    </div>

    <!-- Section 4 -->
    <div class="py-3 border-bottom">
        <h4 class="fw-bold mb-3" style="color: #7c2629;">4. Security &amp; Retention</h4>
        <p class="text-secondary lh-lg mb-0">We implement administrative and technical security measures to prevent data loss or unauthorized access. Transaction records are retained for five years to comply with tax laws; all other data is kept only as long as necessary.</p>
    </div>

    <!-- Section 5 -->
    <div class="py-3 border-bottom">
        <h4 class="fw-bold mb-3" style="color: #7c2629;">5. Your Legal Rights</h4>
        <p class="text-secondary lh-lg mb-0">You have the right to request access to, correction of, or deletion of your personal data, as well as the right to opt out of direct marketing communications at any time. We respond to requests within 30 days.</p>
    </div>

    <!-- Section 6 -->
    <div class="pt-3">
        <h4 class="fw-bold mb-3" style="color: #7c2629;">6. Contact &amp; Complaints</h4>
        <ul class="list-unstyled text-secondary lh-lg mb-0">
            <li class="mb-2"><strong>Data Controller:</strong> Social Exposure</li>
            <li class="mb-2"><strong>Contact Us:</strong> Via website contact form or email for inquiries or address requests.</li>
            <li><strong>Regulator:</strong> You have the right to lodge a privacy complaint with the Office of the Australian Information Commissioner (OAIC).</li>
        </ul>
    </div>

</div>