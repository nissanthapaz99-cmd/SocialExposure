@{
    ViewData["Title"] = "About";
}

<section class="public-info-page">
    <a class="info-back-button"
   asp-controller="Account"
   asp-action="Login">
    ← Back to Login
</a>
    <div class="info-heading">
        <h1>About Social Exposure</h1>
        <p>Learn more about our design management platform.</p>
    </div>

    <div class="info-card">
        <h2>Social Exposure Design Platform</h2>
        <p>
            Social Exposure is a design management platform that helps clients,
            staff and administrators manage events, designs and approvals in one place.
        </p>

        <h3>What We Do</h3>
        <p>
            Our platform makes it easier to create events, upload designs,
            communicate with clients and manage the design approval process.
        </p>

        <h3>Our Goal</h3>
        <p>
            Our goal is to provide a simple and organised system where clients
            and staff can work together efficiently.
        </p>
    </div>
</section>