@{
    ViewData["Title"] = "Contact";
}

<section class="public-info-page">
    <a class="info-back-button"
       asp-controller="Account"
       asp-action="Login">
        ← Back to Login
    </a>
    
    <div class="info-heading">
        <h1>Contact Us</h1>
        <p>Get in touch with the Social Exposure team.</p>
    </div>

    <div class="info-card">
        <h2>We're Here to Help</h2>

        <!-- Phone Section -->
        <div class="contact-item">
            <div class="contact-line">
                <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <a href="tel:1300236894" class="contact-link underline">1300 236 894</a>
            </div>
            <p>Contact our team if you need help with your account, events or designs.</p>
        </div>

        <!-- Email Section -->
        <div class="contact-item">
            <div class="contact-line">
                <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
                <a href="mailto:support@socialexposure.com" class="contact-link">support@socialexposure.com</a>
            </div>
            <p>Contact the Social Exposure team by email for general enquiries.</p>
        </div>

        <!-- Business Hours Section -->
        <div class="contact-item">
            <div class="contact-line">
                <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <strong>Business Hours</strong>
            </div>
            <p>Monday to Friday</p>
        </div>
    </div>
</section>