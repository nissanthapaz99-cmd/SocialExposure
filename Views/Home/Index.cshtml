@{ ViewData["Title"] = "Home"; }
<section class="hero">
    <!--<div class="brand-mark large-brand"><strong>S <i>•••</i> cial Exposure</strong><span>DESIGN</span></div>-->
    <img src="~/images/logo-black.png" alt="Social Exposure Events" class="home-logo" />
    <h1>Social Exposure Design Platform</h1>
    <p class="hero-subtitle">Built for Social Exposure teams and clients to manage design approvals in one place</p>
    <div class="access-grid">
        <article class="access-card">
           <!-- <div class="feature-icon">♙</div>-->
            <h2>Client Access</h2>
            <p>Create an account to review designs, provide feedback, and approve deliverables for your projects.</p>
            <div class="button-row">
                <a class="se-button peach" asp-controller="Account" asp-action="Login">⇥&nbsp; Login</a>
                <a class="se-button outline peach-outline" asp-controller="Account" asp-action="Register">Sign Up</a>
            </div>
            <p class="access-note">New clients verify their email, then wait for administrator approval</p>
        </article>
        <article class="access-card staff">
           <!-- <div class="feature-icon">♢</div> -->
            <h2>Staff / Admin Access</h2>
            <p>Internal team access for managing projects, uploading designs, coordinating approvals, and full administrative control.</p>
            <div class="button-row">
                <a class="se-button" asp-controller="Account" asp-action="StaffLogin">⇥&nbsp; Login</a>
            </div>
            <p class="access-note">Staff and administrator accounts are created by an administrator</p>
        </article>
    </div>
    <div class="unified-note"><strong>Unified Login Platform:</strong> Clients register with email verification and administrator approval. Staff and admin users log in with secure credentials and gain access based on their assigned role.</div>
</section>
<section class="feature-strip" id="about">
  <!--  <div class="mini-feature"><i>📊</i><h3>Project Tracking</h3><p>Monitor all design projects and their progress in real-time</p></div>
    <div class="mini-feature"><i>✓</i><h3>Client Review &amp; Approval</h3><p>Streamlined feedback and approval workflow for faster decisions</p></div>
    <div class="mini-feature"><i>💬</i><h3>Internal Communication</h3><p>Collaborate seamlessly with team members and clients</p></div> -->
    <div class="feature-strip">
    <div class="mini-feature"><i class="bi bi-bar-chart-line feature-icon"></i><h3>Project Tracking</h3><p>Monitor all design projects and their progress in real-time</p></div>
    <div class="mini-feature"><i class="bi bi-check-circle feature-icon"></i><h3>Client Review & Approval</h3><p>Streamlined feedback and approval workflow for faster decisions</p></div>
    <div class="mini-feature"><i class="bi bi-chat-square-text feature-icon"></i><h3>Internal Communication</h3><p>Collaborate seamlessly with team members and clients</p></div>
</div>
</div>
</section>
